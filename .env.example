# switchManager settings - copy to .env and fill in. .env is git-ignored; never commit real values.

# SSH (an empty password is asked once at runtime)
SWITCH_USERNAME=admin
SWITCH_PASSWORD=
SWITCH_ENABLE_SECRET=
SWITCH_DEVICE_TYPE=cisco_ios
SSH_PORT=22
SSH_TIMEOUT=20

# Batch apply: switches in parallel. 1 = serial, in inventory order (recommended)
BATCH_MAX_WORKERS=1

# Default gateway of a Layer 2 switch, derived from its management VLAN: first | last | <explicit IPv4>
MGMT_GATEWAY=first

# 'switchport trunk encapsulation dot1q' on trunks: auto (only ISL-capable models such as 3560/3750) | yes | no
TRUNK_ENCAPSULATION=auto

# Backup via TFTP. Ports below 1024 need: sudo sysctl -w net.ipv4.ip_unprivileged_port_start=69
TFTP_BIND_ADDRESS=0.0.0.0
TFTP_PORT=69
# Address the switch uses to reach this PC; empty = the local address on the route to the switch
TFTP_SERVER_ADDRESS=
TFTP_TIMEOUT=60
BACKUP_DIR=backup
# Back up the running config at the end of every successful --apply
BACKUP_AFTER_APPLY=true
